# Shared, non-secret configuration for staging and production.
# Loaded first via `env_file: [.env.common, .env.<environment>]` -
# env-specific/secret values in .env.staging / .env.production override these.
# Safe to commit. Do not put secrets or hostnames here.

AUXILIARY_QUEUE_TENANTS='sdapi'
AWS_REGION='us-east-1'
CH12N_TOOL='fits_servlet'
DATABASE_ADAPTER='postgresql'
DATABASE_HOST='db'
DB_ADAPTER='postgresql'
DB_HOST='db'
DB_PORT='5432'
FCREPO_HOST='fcrepo'
FCREPO_PATH='/rest'
FCREPO_PORT='8080'
FCREPO_REST_PATH='rest'
FEDORA_URL='http://fcrepo:8080/rest'
FITS_SERVLET_URL='http://fits:8080/fits'
GOOD_JOB_CLEANUP_DISCARDED_JOBS='false'
GOOD_JOB_CLEANUP_INTERVAL_SECONDS='86400'
GOOD_JOB_CLEANUP_PRESERVED_JOBS_BEFORE_SECONDS_AGO='604800'
HYKU_ADMIN_ONLY_TENANT_CREATION='true'
HYKU_ALLOW_SIGNUP='false'
HYKU_ATTACK_RATE_THROTTLE_OFF='false'
HYKU_ATTACK_RATE_LIMIT=10
HYKU_ATTACK_RATE_PERIOD=30
HYKU_BLOCK_VALKYRIE_REDIRECT='false'
HYKU_BULKRAX_ENABLED='true'
HYKU_CONTACT_EMAIL='donotreply@adventistdigitallibrary.org'
HYKU_FILE_ACL='true'
HYKU_GEONAMES_USERNAME='scientist'
HYKU_MULTITENANT='true'
HYKU_QUEUED_RUNNER='true'
HYRAX_ACTIVE_JOB_QUEUE='good_job'
HYRAX_ANALYTICS='false'
HYRAX_BRANDING_PATH='/app/samvera/branding'
HYRAX_CACHE_PATH='/app/samvera/file_cache'
HYRAX_DERIVATIVES_PATH='/app/samvera/derivatives'
HYRAX_FITS_PATH='/app/fits/fits.sh'
HYRAX_FLEXIBLE='false'
HYRAX_UPLOAD_PATH='/app/samvera/uploads'
HYRAX_VALKYRIE='true'
INITIAL_ADMIN_EMAIL='support@notch8.com'
IN_DOCKER='true'
PASSENGER_APP_ENV='production'
RACK_ENV='production'
RAILS_ENV='production'
RAILS_LOG_TO_STDOUT='true'
RAILS_MAX_THREADS='5'
RAILS_ROOT='/app/samvera/hyrax-webapp'
RAILS_SERVE_STATIC_FILES='true'
REDIS_HOST='redis'
REDIS_PROVIDER='SIDEKIQ_REDIS_URL'
REPOSITORY_S3_REGION='us-east-1'
REPOSITORY_S3_STORAGE='true'
# SMTP_ADDRESS/SMTP_DOMAIN/SMTP_USER_NAME moved to .env.<environment> - even
# without the password, that combination identifies a specific real mailbox
# and server, which is exactly what a secret scanner correctly flagged.
SMTP_ENABLED='true'
SMTP_PORT='587'
SMTP_TYPE='plain'
SOLR_ADMIN_USER='solr'
SOLR_HOST='solr'
SOLR_PORT='8983'
SOLR_USER="solr"
VALKYRIE_ID_TYPE='string'
VALKYRIE_TRANSITION='true'
