#!/bin/bash
# Pulls .env.staging / .env.production down from the shared ADVENTIST 1Password
# vault, the same way provision/bin/run already does for id_rsa/ghcr_token/etc.
# Run from anywhere; always writes to the repo root.
#
# One-time setup, once you have real values in .env.staging / .env.production locally:
#   op document create .env.staging    --title ENV_STAGING_SECRETS    --vault "ADVENTIST"
#   op document create .env.production --title ENV_PRODUCTION_SECRETS --vault "ADVENTIST"
#
# To push an updated version after rotating a secret:
#   op document edit ENV_STAGING_SECRETS    .env.staging
#   op document edit ENV_PRODUCTION_SECRETS .env.production
#
# Make sure you are logged in via: `eval $(op signin)`
set -euo pipefail

ENVIRONMENT="${1:-}"
case "$ENVIRONMENT" in
  staging) TITLE=ENV_STAGING_SECRETS ;;
  production) TITLE=ENV_PRODUCTION_SECRETS ;;
  *)
    echo "Usage: provision/bin/fetch-secrets <staging|production>" >&2
    exit 1
    ;;
esac

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
OUT_FILE="$REPO_ROOT/.env.$ENVIRONMENT"

op document get "$TITLE" --out-file "$OUT_FILE" --force
echo "Wrote $OUT_FILE from 1Password ($TITLE)"
